# Frontend environment.
#
# Copy to `.env.local` (gitignored) and adjust if the API is not on the default
# port. Nothing secret belongs in this file: everything here is readable by the
# browser or trivially discoverable, and the frontend holds no credentials at all
# — it talks only to Internet Weather's own API, never to GitHub or an LLM.

# Base URL used by server components. No trailing slash.
API_BASE_URL=http://127.0.0.1:8000

# Same value, exposed to the browser. Only needed once a client component fetches
# directly; the current pages all fetch on the server.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
