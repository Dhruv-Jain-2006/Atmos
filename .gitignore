# ── Generated but committed ──────────────────────────────────────────────────
# docs/openapi.json and frontend/lib/types.gen.ts are deliberately NOT ignored.
# The frontend must build without a running backend, and a committed contract
# means schema drift arrives as a reviewable diff instead of a runtime surprise.
# Regenerate with: uv run python scripts/dump_openapi.py && npm --prefix frontend run codegen

