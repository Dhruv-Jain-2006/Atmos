# ── Database ─────────────────────────────────────────────────────────────────
# Neon pooled connection string. Use the -pooler host: the API is stateless and
# short-lived, so PgBouncer keeps Neon from spending compute on connection setup.
# Leave EMPTY to run the API in degraded mode (boots, serves contracts, no data).
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx-pooler.region.aws.neon.tech/internetweather?sslmode=require

# Direct (non-pooled) connection. Alembic migrations and workers use this —
# DDL and long transactions do not belong on a pooled connection.
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/internetweather?sslmode=require

# ── GitHub ingestion ─────────────────────────────────────────────────────────
# A fine-grained PAT with public read access only.
# Do NOT use the Actions-provided GITHUB_TOKEN for ingestion: it is capped at
# 1,000 requests/hour per repository, versus 5,000/hour for a PAT.
GITHUB_TOKEN=

# ── LLM providers (not used in the first vertical slice) ─────────────────────
# The provider abstraction picks the first configured backend in this order.
LLM_PROVIDER=none          # none | gemini | ollama
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
